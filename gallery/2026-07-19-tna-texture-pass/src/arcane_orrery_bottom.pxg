# arcane orrery — bottom face, r2. Plain greatwood plank underside at FULL
# brightness: the engine renders bottom faces at 0.5, so this must NOT be
# pre-darkened (directional-shading lesson) — r1 baked a dark field and would
# double-darken in-game. Neutral plank field, one seam row.
size: 16x16
[palette]
D = 30201C   # greatwood seam/deep
S = 3E2C1F   # greatwood shadow
B = 4F3B25   # greatwood base
H = 60492C   # greatwood highlight
