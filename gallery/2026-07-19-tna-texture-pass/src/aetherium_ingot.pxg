# aetherium ingot — same silhouette as brass ingot (family consistency),
# aetherium ramp + the mandatory single teal glint on the top face.
size: 16x16
[palette]
. = none
N = 3F2E5E   # border / deep
n = 5A4380   # shadow (card)
m = 8A6BB5   # base (card)
o = B99BE0   # highlight (card)
f = D8C8F0   # specular
g = 7FE8D8   # glint (card)
