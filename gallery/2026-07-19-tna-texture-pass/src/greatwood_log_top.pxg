# greatwood log — top face, r3 (user: core needs improving).
# Richer end-grain: bark rim, sap highlight ring, TWO dark growth rings that
# tighten toward the center (old growth), chamfered ring corners so nothing
# reads as a perfect square, dense checkered heart.
size: 16x16
[palette]
f = 3A2D22   # furrow (bark rim breaks)
k = 4E3D2E   # bark rim
D = 30201C   # ring line / heart dark
S = 3E2C1F   # inner ring / heart
B = 4F3B25   # wood base
H = 60492C   # sap ring highlight
[grid]
fkkkkfkkkkkkfkkf
kBBBBBBBBBBBBBBk
kBHHHHHHHBHHHHBk
kBHBBBBBBBBBBHBk
kBHBBSSSSSSBBHBk
kBHBSBBBBBBSBHBk
kBHBSBDDDDBSBHBk
kBHBSBDDSDBSBHBk
kBHBSBDSDDBSBHBk
kBHBSBDDDDBSBHBk
kBHBSBBBBBBSBHBk
kBHBBSSSSSSBBHBk
kBHBBBBBBBBBBHBk
kBHHHHHBHHHHHHBk
kBBBBBBBBBBBBBBk
fkkkkkkkkfkkkkkf
