# silverwood sapling — same silhouette as greatwood sapling (family
# consistency), pale blue-green canopy, pale trunk, and the card's teal
# sapling-glow: two canopy shimmer pixels + one drifting spark.
size: 16x16
[palette]
. = none
D = 6F9E94   # canopy deepest
s = 8BBFAC   # canopy shadow
b = A9D8C4   # canopy base (card)
l = C0E8D6   # canopy light
h = D5F2E6   # canopy highlight
k = D9DED9   # bark (card)
f = AAB2AC   # streak (card)
g = 7FE8D8   # sapling glow (card magic accent)
