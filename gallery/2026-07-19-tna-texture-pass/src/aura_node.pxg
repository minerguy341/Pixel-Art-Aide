# aura node — r2: orb rebuilt on the diameter-13 circle from the pixel-circle
# chart (knowledge/references/pixel-circle-chart.webp) — the r1 freehand round
# was lumpy. Shell lit top-left (r) -> base right (q) -> shadow bottom (p);
# teal glass fill with a diagonal swirl and two core sparks.
size: 16x16
[palette]
. = none
r = B99BE0   # shell, lit (aetherium highlight)
q = 8A6BB5   # shell, mid (aetherium base)
p = 5A4380   # shell, shadowed (aetherium shadow)
t = 7FCFC4   # glass fill
d = 55A89E   # glass fill, deep
g = 7FE8D8   # swirl glint (card accent)
w = E8FFFA   # core spark
[grid]
................
.....rrrrr......
...rrtttttqq....
..rttgttttdtq...
..rttggtttttq...
.rttggdgttttdq..
.rtgdwggttttdq..
.rttgggwgtttdq..
.qttdgggttttdp..
.qtttdggtttddp..
..qttddgttttp...
..qtttttdttdp...
...pptttddpp....
.....ppppp......
