# aura node — revisit of the placeholder. Glassy aura orb: aetherium shell
# lit top-left, teal glass fill with swirl glints and a bright core.
# TC nodes were rendered glassy orbs; this is the sprite-side equivalent,
# sitting under the AuraNodeRenderer's effects.
size: 16x16
[palette]
. = none
r = B99BE0   # shell, lit (aetherium highlight)
q = 8A6BB5   # shell, right (aetherium base)
p = 5A4380   # shell, shadowed (aetherium shadow)
t = 7FCFC4   # glass fill
d = 55A89E   # glass fill, deep
g = 7FE8D8   # swirl glint (card accent)
w = E8FFFA   # core spark
