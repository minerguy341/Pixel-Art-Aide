# wand_base — grayscale tint template (multiplied by material color at runtime)
# Layout (disjoint regions, matches remapped model UVs):
#   cols 0-1, rows 0-15: rod strip (tintindex 0) — lit left col, carved rings
#   cols 4-7, rows 0-3:  cap patch (tintindex 1/2) — lit top-left, metal steps
# Everything else transparent. Grays are neutral so tint hue is unchanged.
size: 16x16
[palette]
. = none
e = E0E0E0   # rod lit
c = C4C4C4   # rod ring / end
a = A0A0A0   # rod shade col
8 = 8A8A8A   # rod ring shade
f = F2F2F2   # cap specular
d = D8D8D8   # cap lit
b = B4B4B4   # cap mid
9 = 969696   # cap shade
7 = 7E7E7E   # cap deep
[grid]
ca..dffd........
ea..ddb9........
ea..bb97........
ea..9977........
c8..............
ea..............
ea..............
ea..............
ea..............
ea..............
c8..............
ea..............
ea..............
ea..............
ea..............
ca..............
